{
  "name": "guestbook-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static frontend for the Guestbook launch: read entries, sign with GUEST, swap ETH/GUEST on Uniswap v4.",
  "scripts": {
    "sync": "node scripts/sync-deployment.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && node scripts/finalize-export.mjs",
    "check-export": "node scripts/finalize-export.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.37.6",
    "wagmi": "^2.17.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
